# Copy to .env only for local development.

# Local Next.js settings and application identity.
# Public URL prefix, built into Next.js; use a leading slash and no trailing slash.
APP_BASE_PATH=/map
# In production, the controller supplies APP_HOST and APP_PORT from inventory.
APP_HOST=127.0.0.1
APP_PORT=3001
PM2_APP_NAME=indoor-mapping
