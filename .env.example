# Copy to .env only for local development.

# Local Next.js setting.
# Public URL prefix, built into Next.js; use a leading slash and no trailing slash.
APP_BASE_PATH=/map

# Server-only credentials for the visitor "Report a problem" form.
# Use a fine-grained token limited to Issues: read/write on this repository.
GITHUB_ISSUE_REPOSITORY=beatybiodiversitymuseum/indoor-mapping
GITHUB_ISSUE_TOKEN=
REPORT_RATE_LIMIT_PER_HOUR=5
